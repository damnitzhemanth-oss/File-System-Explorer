{
  "name": "file-system-explorer",
  "displayName": "File System Explorer",
  "description": "Generate file tree structures and view all file contents.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/file-system-explorer.git"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fileSystemExplorer.showFileStructure",
        "title": "File Structure",
        "category": "File System Explorer"
      },
      {
        "command": "fileSystemExplorer.showEntireFileSystem",
        "title": "Entire File System",
        "category": "File System Explorer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "esbuild": "^0.17.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "ignore": "^5.2.4",
    "tree-node-cli": "^1.6.0"
  }
}